                  ]
                }
              }
            ]
          }
        ]
      },
      "bot:on_tame": {
        "remove": {
          "component_groups": [
            "bot:wild",
            "bot:staying"
          ]
        },
        "add": {
          "component_groups": [
            "bot:tamed",
            "bot:combat",
            "bot:following"
          ]
        }
      },
      "bot:sit": {
        "remove": {
          "component_groups": [
            "bot:following",
            "bot:working"
          ]
        },
        "add": {
          "component_groups": [
            "bot:staying"
          ]
        }
      },
      "bot:follow": {
        "remove": {
          "component_groups": [
            "bot:staying",
            "bot:working"
          ]
        },
        "add": {
          "component_groups": [
            "bot:following"
          ]
        }
      },
      "bot:stop": {
        "remove": {
          "component_groups": [
            "bot:combat",
            "bot:staying",
            "bot:working"
          ]
        },
        "add": {
          "component_groups": [
            "bot:following"
          ]
        }
      },
      "bot:resume_combat": {
        "add": {
          "component_groups": [
            "bot:combat"
          ]
        }
      },
      "bot:work_start": {
        "remove": {
          "component_groups": [
            "bot:following",
            "bot:staying",
            "bot:combat"
          ]
        },
        "add": {
          "component_groups": [
            "bot:working"
          ]
        }
      },
      "bot:work_end": {
        "remove": {
          "component_groups": [
            "bot:working"
          ]
        },
        "add": {
          "component_groups": [
            "bot:following",
            "bot:combat"
          ]
        }
      }
