{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bot:companion",
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "bot:wild": {
        "minecraft:tameable": {
          "probability": 1.0,
          "tame_items": [
            "apple",
            "cookie"
          ],
          "tame_event": {
            "event": "bot:on_tame",
            "target": "self"
          }
        },
        "minecraft:behavior.random_stroll": {
          "priority": 8,
          "speed_multiplier": 0.8
        }
      },
      "bot:tamed": {
        "minecraft:is_tamed": {},
        "minecraft:inventory": {
          "inventory_size": 27,
          "container_type": "minecart_chest",
          "restrict_to_owner": true
        }
      },
      "bot:combat": {
        "minecraft:behavior.owner_hurt_by_target": {
          "priority": 1
        },
        "minecraft:behavior.owner_hurt_target": {
          "priority": 2
        },
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 4,
          "must_see": true,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "monster"
                  },
                  {
                    "test": "is_family",
                    "subject": "other",
                    "operator": "!=",
                    "value": "creeper"
                  }
                ]
              },
              "max_dist": 12
            }
          ]
        },
        "minecraft:behavior.hurt_by_target": {
          "priority": 2,
          "entity_types": {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "operator": "!=",
              "value": "player"
            }
          }
        },
        "minecraft:behavior.melee_attack": {
          "priority": 3,
          "speed_multiplier": 1.2,
          "track_target": true
        }
      },
      "bot:following": {
        "minecraft:behavior.teleport_to_owner": {
          "priority": 1,
          "filters": {
            "test": "owner_distance",
            "operator": ">",
            "value": 12
          }
        },
        "minecraft:behavior.follow_owner": {
          "priority": 6,
          "speed_multiplier": 1.4,
          "start_distance": 4,
          "stop_distance": 2
        },
        "minecraft:behavior.random_stroll": {
          "priority": 9,
          "speed_multiplier": 0.8
        }
      },
      "bot:staying": {
        "minecraft:behavior.random_look_around": {
          "priority": 9
        }
      },
      "bot:working": {
        "minecraft:behavior.nearest_attackable_target": {
          "priority": 1,
          "must_see": false,
          "must_reach": false,
          "reselect_targets": true,
          "entity_types": [
            {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "bot_waypoint"
              },
              "max_dist": 32
            }
          ]
        },
        "minecraft:behavior.melee_attack": {
          "priority": 2,
          "speed_multiplier": 1.3,
          "track_target": true
        }
      },
